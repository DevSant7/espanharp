fx_version "cerulean"
game "gta5"
lua54 "yes"

title "LB Phone - Banking App (Oceania)"
author "Rexie Development (adaptado para OceaniaV5)"
version "1.1.0"

client_script {
    "@vrp/lib/utils.lua",
    "client.lua"
}

server_script {
    "@vrp/lib/utils.lua",
    "@oxmysql/lib/MySQL.lua",
    "server.lua"
}

files {
    "ui/dist/**/*",
    "ui/icon.png"
}

ui_page "ui/dist/index.html"

dependencies {
    "vrp",
    "oxmysql",
    "lb-phone"
}
